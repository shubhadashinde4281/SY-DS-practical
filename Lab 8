#include <iostream>
using namespace std;
int main() {
    int id[] = {101, 102, 103, 104, 105};
    int key, i, low = 0, high = 4, mid, choice;
    cout<<"library managment system \n";
    cout << "1. Linear Search\n2. Binary Search\n";
    cout << "Enter choice: ";
    cin >> choice;
    cout << "Enter Book ID: ";
    cin >> key;
    if (choice == 1) {
        for (i = 0; i < 5; i++) {
            if (id[i] == key) {
                cout << "Book Found\n";
                return 0;
            }
        }
        cout << "Book Not Found\n";
    }
    else if (choice == 2) {
        while (low <= high) {
            mid = (low + high) / 2;
            if (id[mid] == key) {
                cout << "Book Found\n";
                return 0;
            }
            else if (id[mid] < key)
                low = mid + 1;
            else
                high = mid - 1;
        }
        cout << "Book Not Found\n";
    }
    return 0;
}
